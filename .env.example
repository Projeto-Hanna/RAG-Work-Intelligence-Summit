# ==========================================================
# VARIÁVEIS DO FRONTEND
# ==========================================================

# Endereço público na porta 8000
BACKEND_URL=http://SEU_IP_EXTERNO_ORACLE:8000

# Token compartilhado entre projetos
BACKEND_API_TOKEN=troque_por_um_token_secreto_longo_e_aleatorio

# Mantém o provedor Llama local oculto na interface em produção
NEXT_PUBLIC_ENABLE_LLAMA=false


# ==========================================================
# VARIÁVEIS DO BACKEND
# ==========================================================

ENV=production
ENABLED_PROVIDERS=gemini,openai,anthropic
LLM_PROVIDER=gemini

# Chaves de API de fallback (usadas quando o usuário deixa em branco na interface)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos padrão de cada provedor
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Parâmetros de geração
MAX_NOVOS_TOKENS=1024
TEMPERATURA=0.3

